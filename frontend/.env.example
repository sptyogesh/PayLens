# Copy to frontend/.env.local and fill in. Never commit real values.
# Backend URL, e.g. http://localhost:8000
NEXT_PUBLIC_API_URL=
# PayPal SANDBOX REST app client ID (public; the secret stays on the backend)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# http | fake  (fake renders a test-mode checkout button; used by E2E)
NEXT_PUBLIC_PAYPAL_MODE=
