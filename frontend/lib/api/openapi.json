  "components": {
    "schemas": {
      "BreakdownRowOut": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "totals": {
            "$ref": "#/components/schemas/TotalsOut"
          }
        },
        "type": "object",
        "required": [
          "key",
          "label",
          "totals"
        ],
        "title": "BreakdownRowOut"
      },
      "CaptureOut": {
        "properties": {
          "transaction_id": {
            "type": "string",
            "title": "Transaction Id"
          },
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "pending"
            ],
            "title": "Status"
          },
          "gross": {
            "$ref": "#/components/schemas/MoneyOut"
          },
          "recorded": {
            "type": "boolean",
            "title": "Recorded"
          }
        },
        "type": "object",
        "required": [
          "transaction_id",
          "order_id",
          "status",
          "gross",
          "recorded"
        ],
        "title": "CaptureOut"
      },
      "ChatIn": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Question"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatTurn"
            },
            "type": "array",
            "maxItems": 6,
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ChatIn"
      },
      "ChatOut": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "answered",
              "no_data",
              "fallback"
            ],
            "title": "Outcome"
          },
          "periods": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Periods"
          },
          "figures": {
            "items": {
              "$ref": "#/components/schemas/FigureOut"
            },
            "type": "array",
            "title": "Figures"
          },
          "disclaimer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disclaimer"
          },
          "tools_used": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tools Used"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "outcome",
          "periods",
          "figures",
          "disclaimer",
          "tools_used"
        ],
        "title": "ChatOut"
      },
      "ChatTurn": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 2000,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatTurn"
      },
      "ClientRef": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "country"
        ],
        "title": "ClientRef"
      },
      "CountsOut": {
        "properties": {
          "added": {
            "type": "integer",
            "title": "Added"
          },
          "updated": {
            "type": "integer",
            "title": "Updated"
          },
          "skipped": {
            "type": "integer",
            "title": "Skipped"
          },
          "flagged": {
            "type": "integer",
            "title": "Flagged"
          }
        },
        "type": "object",
        "required": [
          "added",
          "updated",
          "skipped",
          "flagged"
        ],
        "title": "CountsOut"
      },
      "DashboardOut": {
        "properties": {
          "period": {
            "$ref": "#/components/schemas/DashboardPeriodOut"
          },
          "totals": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TotalsOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "excluded_count": {
            "type": "integer",
            "title": "Excluded Count"
          },
          "not_calculated_count": {
            "type": "integer",
            "title": "Not Calculated Count"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/TransactionSource"
            },
            "type": "array",
            "title": "Sources"
          },
          "paypal_rate_simulated": {
            "type": "boolean",
            "const": true,
            "title": "Paypal Rate Simulated",
            "default": true
          },
          "simulated_spread_percent": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$",
            "title": "Simulated Spread Percent"
          },
          "by_month": {
            "items": {
              "$ref": "#/components/schemas/BreakdownRowOut"
            },
            "type": "array",
            "title": "By Month"
          },
          "by_client": {
            "items": {
              "$ref": "#/components/schemas/BreakdownRowOut"
            },
            "type": "array",
            "title": "By Client"
          }
        },
        "type": "object",
        "required": [
          "period",
          "totals",
          "excluded_count",
          "not_calculated_count",
          "sources",
          "simulated_spread_percent",
          "by_month",
          "by_client"
        ],
        "title": "DashboardOut"
      },
      "DashboardPeriod": {
        "type": "string",
        "enum": [
          "this_month",
          "last_3_months",
          "all_time"
        ],
        "title": "DashboardPeriod"
      },
      "DashboardPeriodOut": {
        "properties": {
          "key": {
            "$ref": "#/components/schemas/DashboardPeriod"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "start": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          },
          "end": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "End"
          }
        },
        "type": "object",
        "required": [
          "key",
          "label",
          "start",
          "end"
        ],
        "title": "DashboardPeriodOut"
      },
      "FigureOut": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "kind": {
            "type": "string",
            "enum": [
              "money",
              "count",
              "percent"
            ],
            "title": "Kind"
          },
          "value": {
            "type": "string",
            "title": "Value"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          },
          "period": {
            "type": "string",
            "title": "Period"
          }
        },
        "type": "object",
        "required": [
          "label",
          "kind",
          "value",
          "currency",
          "period"
        ],
        "title": "FigureOut",
        "description": "A figure behind the answer, copied from a tool result by code (FR-005)."
      },
      "FiraDocStatus": {
        "type": "string",
        "enum": [
          "matched",
          "needs_review",
          "no_match"
        ],
        "title": "FiraDocStatus"
      },
      "FiraItemOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "file_name": {
            "type": "string",
            "title": "File Name"
          },
          "status": {
            "$ref": "#/components/schemas/FiraDocStatus"
          },
          "score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "foreign_amount": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MoneyOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "inr_amount": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MoneyOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "rate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rate"
          },
          "remittance_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remittance Date"
          },
          "reference_no": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference No"
          },
          "remitter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remitter"
          },
          "purpose_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purpose Code"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time",
            "title": "Uploaded At"
          },
          "matches": {
            "items": {
              "$ref": "#/components/schemas/FiraMatchOut"
            },
            "type": "array",
            "title": "Matches"
          }
        },
        "type": "object",
        "required": [
          "id",
          "file_name",
          "status",
          "score",
          "reason",
          "foreign_amount",
          "inr_amount",
          "rate",
          "remittance_date",
          "reference_no",
          "remitter",
          "purpose_code",
          "uploaded_at",
          "matches"
        ],
        "title": "FiraItemOut"
      },
      "FiraListOut": {
        "properties": {
          "summary": {
            "$ref": "#/components/schemas/FiraSummaryOut"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/FiraItemOut"
            },
            "type": "array",
            "title": "Items"
          },
          "missing": {
            "items": {
              "$ref": "#/components/schemas/FiraPaymentOut"
            },
            "type": "array",
            "title": "Missing"
          }
        },
        "type": "object",
        "required": [
          "summary",
          "items",
          "missing"
        ],
        "title": "FiraListOut"
      },
      "FiraMatchKind": {
        "type": "string",
        "enum": [
          "direct",
          "weekly"
        ],
        "title": "FiraMatchKind"
      },
      "FiraMatchOut": {
        "properties": {
          "transaction_id": {
            "type": "string",
            "format": "uuid",
            "title": "Transaction Id"
          },
          "paypal_transaction_id": {
            "type": "string",
            "title": "Paypal Transaction Id"
          },
          "score": {
            "type": "integer",
            "title": "Score"
          },
          "kind": {
            "$ref": "#/components/schemas/FiraMatchKind"
