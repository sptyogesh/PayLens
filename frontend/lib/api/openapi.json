{
  "openapi": "3.1.0",
  "info": {
    "title": "PayLens API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/sync": {
      "post": {
        "tags": [
          "sync"
        ],
        "summary": "Post Sync",
        "operationId": "post_sync_sync_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/SyncRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncRunOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sync/last": {
      "get": {
        "tags": [
          "sync"
        ],
        "summary": "Last Sync",
        "operationId": "last_sync_sync_last_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/SyncRunOut"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Response Last Sync Sync Last Get"
                }
              }
            }
          }
        }
      }
    },
    "/transactions": {
      "get": {
        "tags": [
          "transactions"
        ],
        "summary": "Get Transactions",
        "operationId": "get_transactions_transactions_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "income",
                "all"
              ],
              "type": "string",
              "default": "income",
              "title": "Kind"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/TransactionSource"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Source"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionListOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClientRef": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "country"
        ],
        "title": "ClientRef"
      },
      "CountsOut": {
        "properties": {
          "added": {
            "type": "integer",
            "title": "Added"
          },
          "updated": {
            "type": "integer",
            "title": "Updated"
          },
          "skipped": {
            "type": "integer",
            "title": "Skipped"
          },
          "flagged": {
            "type": "integer",
            "title": "Flagged"
          }
        },
        "type": "object",
        "required": [
          "added",
          "updated",
          "skipped",
          "flagged"
        ],
        "title": "CountsOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MoneyOut": {
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$",
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "title": "Currency"
          }
        },
        "type": "object",
        "required": [
          "amount",
          "currency"
        ],
        "title": "MoneyOut"
      },
      "PeriodOut": {
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          }
        },
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "title": "PeriodOut"
      },
      "SyncErrorOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "SyncErrorOut"
      },
      "SyncOutcome": {
        "type": "string",
        "enum": [
          "running",
          "success",
          "partial",
          "failed"
        ],
        "title": "SyncOutcome"
      },
      "SyncRequest": {
        "properties": {
          "start": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          },
          "end": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "End"
          }
        },
        "type": "object",
        "title": "SyncRequest"
      },
      "SyncRunOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "trigger": {
            "$ref": "#/components/schemas/SyncTrigger"
          },
          "period": {
            "$ref": "#/components/schemas/PeriodOut"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "outcome": {
            "$ref": "#/components/schemas/SyncOutcome"
          },
          "windows": {
            "$ref": "#/components/schemas/WindowsOut"
          },
          "counts": {
            "$ref": "#/components/schemas/CountsOut"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SyncErrorOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hint"
          }
        },
        "type": "object",
        "required": [
          "id",
          "trigger",
          "period",
          "started_at",
          "finished_at",
          "outcome",
          "windows",
          "counts",
          "error",
          "hint"
        ],
        "title": "SyncRunOut"
      },
      "SyncTrigger": {
        "type": "string",
        "enum": [
          "manual",
          "startup"
        ],
        "title": "SyncTrigger"
      },
      "TransactionKind": {
        "type": "string",
        "enum": [
          "income",
          "outgoing_payment",
          "refund",
          "withdrawal",
          "conversion",
          "hold",
          "fee",
          "other"
        ],
        "title": "TransactionKind"
      },
      "TransactionListOut": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TransactionOut"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "TransactionListOut"
      },
      "TransactionOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "paypal_transaction_id": {
            "type": "string",
            "title": "Paypal Transaction Id"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "client": {
            "$ref": "#/components/schemas/ClientRef"
          },
          "kind": {
            "$ref": "#/components/schemas/TransactionKind"
          },
          "status": {
            "$ref": "#/components/schemas/TransactionStatus"
          },
          "gross": {
            "$ref": "#/components/schemas/MoneyOut"
          },
          "fee": {
            "$ref": "#/components/schemas/MoneyOut"
          },
          "net": {
            "$ref": "#/components/schemas/MoneyOut"
          },
          "source": {
            "$ref": "#/components/schemas/TransactionSource"
          },
          "is_flagged": {
            "type": "boolean",
            "title": "Is Flagged"
          }
        },
        "type": "object",
        "required": [
          "id",
          "paypal_transaction_id",
          "occurred_at",
          "client",
          "kind",
          "status",
          "gross",
          "fee",
          "net",
          "source",
          "is_flagged"
        ],
        "title": "TransactionOut"
      },
      "TransactionSource": {
        "type": "string",
        "enum": [
          "paypal_sandbox",
          "demo_seed"
        ],
        "title": "TransactionSource"
      },
      "TransactionStatus": {
        "type": "string",
        "enum": [
          "completed",
          "pending",
          "denied",
          "reversed"
        ],
        "title": "TransactionStatus"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WindowsOut": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "done": {
            "type": "integer",
            "title": "Done"
          }
        },
        "type": "object",
        "required": [
          "total",
          "done"
        ],
        "title": "WindowsOut"
      }
    }
  }
}
