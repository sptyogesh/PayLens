# Copy to backend/.env and fill in. Never commit .env.
# development | test | production
APP_ENV=
# http | fake  (fake is only allowed when APP_ENV=test)
PAYPAL_MODE=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox only: https://api-m.sandbox.paypal.com
PAYPAL_BASE_URL=
# e.g. postgresql+psycopg://user:pass@localhost:5432/paylens_dev
DATABASE_URL=
# Used by pytest only, e.g. postgresql+psycopg://localhost/paylens_test
TEST_DATABASE_URL=
# Deployed frontend URL allowed by CORS (localhost:3000 is always allowed)
FRONTEND_URL=
# Proxies allowed to set X-Forwarded-For (IPs/CIDRs). Default 127.0.0.1; see render.yaml for Render.
FORWARDED_ALLOW_IPS=
# FX mid-market rates (Frankfurter, keyless). FX_MODE=fake only with APP_ENV=test.
FX_MODE=http
FX_API_URL=https://api.frankfurter.dev
# Ask Your Money (Anthropic Messages API). Secret: set in backend/.env or Render only.
LLM_MODE=http
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_API_URL=https://api.anthropic.com
