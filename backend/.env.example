# Copy to backend/.env and fill in. Never commit .env.
# development | test | production
APP_ENV=
# http | fake  (fake is only allowed when APP_ENV=test)
PAYPAL_MODE=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox only: https://api-m.sandbox.paypal.com
PAYPAL_BASE_URL=
# e.g. postgresql+psycopg://user:pass@localhost:5432/paylens_dev
DATABASE_URL=
# Used by pytest only, e.g. postgresql+psycopg://localhost/paylens_test
TEST_DATABASE_URL=
# Deployed frontend URL allowed by CORS (localhost:3000 is always allowed)
FRONTEND_URL=
# Proxies allowed to set X-Forwarded-For (IPs/CIDRs). Default 127.0.0.1; see render.yaml for Render.
FORWARDED_ALLOW_IPS=
# FX mid-market rates (Frankfurter, keyless). FX_MODE=fake only with APP_ENV=test.
FX_MODE=http
FX_API_URL=https://api.frankfurter.dev
# AI (chat, FIRA reading, report summary). Secret: set in backend/.env or Render only.
# LLM_PROVIDER: anthropic or gemini; empty = detected from the key (sk-ant- / AIza / AQ.).
# A key that belongs to another provider than LLM_PROVIDER stops the backend at startup.
# LLM_MODEL / LLM_API_URL: empty = the provider default (claude-opus-5-5 / gemini-3.6-flash).
# Gemini free tier: Google may use what is sent to improve its products; send sandbox data only.
LLM_MODE=http
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_API_URL=
# Load the labelled demo seed at startup (hosts without a shell). Idempotent.
SEED_DEMO_ON_STARTUP=false
